{
  "manifest_version": 3,
  "name": "门户收录",
  "version": "0.1.0",
  "description": "把当前页作为书签条目写入门户源",
  "homepage_url": "https://github.com/jasper0507/webdirectory-extension",
  "icons": {
    "16": "icons/ring-16.png",
    "32": "icons/ring-32.png",
    "48": "icons/ring-48.png",
    "128": "icons/ring-128.png"
  },
  "action": {
    "default_title": "门户收录",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/ring-16.png",
      "32": "icons/ring-32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "打开门户收录"
    }
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://api.github.com/*"]
}
